NEXT_PUBLIC_SUPABASE_URL=https://stoocngdvtgvbbvdjmdo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DRiclP8oRtQvspRQ2rPelg_OcVtpSNs

# Required for server-side photo uploads (Supabase → Settings → API Keys → service_role or secret key)
# Add this to Vercel environment variables too — never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Super Admin (/superadmin) — password for operational data reset tools
SUPERADMIN_PASSWORD=steer-super
# Optional: HMAC pepper for the superadmin cookie (falls back to service role key)
SUPERADMIN_SECRET=

# Optional — branded inquiry emails via Resend (https://resend.com)
# If unset, the contact form still emails the office inbox automatically.
RESEND_API_KEY=
RESEND_FROM=Steer Builders <beth.t@example.com>
INQUIRY_NOTIFICATION_EMAIL=info@steerbuilderscorporation.com

